# LLM (chat agent). ANTHROPIC_API_KEY is only needed when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5

# Local model via Ollama (RTX 3080 10 GB): uncomment these and comment out the two LLM_ lines above.
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434
# LLM_NUM_CTX=8192

# Embeddings (local, no key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Storage (relative paths resolve against backend/)
DUCKDB_PATH=../data/dashboard.duckdb
UPLOAD_DIR=../data/uploads

CORS_ORIGINS=http://localhost:5173

# Postgres (docker compose up -d db). Use 127.0.0.1, not localhost: Docker Desktop only maps IPv4 and
# localhost tries IPv6 first, which stalls every new connection for several seconds.
DATABASE_URL=postgresql://lettings:lettings@127.0.0.1:5432/lettings
READONLY_DATABASE_URL=postgresql://lettings_ro:lettings_ro@127.0.0.1:5432/lettings

# TfL Unified API key (optional; anonymous works but is throttled). Register at https://api-portal.tfl.gov.uk/
TFL_APP_KEY=
