# Settings for the API on the Pi: /etc/lettings/lettings.env (bootstrap.sh creates it with generated database passwords).
# Read by systemd, so no quotes and no "export".
ENVIRONMENT=production

DATABASE_URL=postgresql://lettings:CHANGE_ME@127.0.0.1:5432/lettings
READONLY_DATABASE_URL=postgresql://lettings_ro:CHANGE_ME@127.0.0.1:5432/lettings

# The model runs on your PC and is reached over Tailscale: use the PC's tailnet name or 100.x address.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
LLM_BASE_URL=http://YOUR-PC-TAILNET-NAME:11434
LLM_NUM_CTX=8192

# Optional: TfL key for higher commute-lookup limits
TFL_APP_KEY=

TIMEZONE=Europe/London
LOG_LEVEL=INFO
