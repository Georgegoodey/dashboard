[Unit]
Description=Lettings API (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=lettings
Group=lettings
WorkingDirectory=/opt/lettings/current/backend
EnvironmentFile=/etc/lettings/lettings.env
# One worker only: the job scheduler runs inside this process, and APScheduler cannot share a job store between processes
# (it would run every job once per worker).
ExecStart=/opt/lettings/current/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-server-header
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

# sandbox: the service needs the network and its own files, nothing else
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
